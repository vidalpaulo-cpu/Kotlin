using System;
using System.Globalization;

Console.Write("Salário base (ex.：1500.00)：");
double salario = double.Parse(Console.ReadLine()??"O", CultureInfo.InvariantCulture);
Console.Write("Comissão (%)：“);
double percentual = double.Parse(Console.ReadLine()??"O", CultureInfo.InvariantCulture);

if (salario < O I| percentual < 0){
    Console.WriteLine("Valores inválidos.");
} else {
    double comissao = salario * percentual / 100;
    Console.WriteLine($"Comissão: R$ {comissao:F2}");
    Console.WriteLine($"Total: {salario+ comissao:F2}");
 }
